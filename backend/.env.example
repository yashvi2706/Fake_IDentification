# =============================================================
# Backend Environment Configuration
# =============================================================

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated origins allowed by the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Face verification
# Supported backends: opencv, ssd, mtcnn, retinaface, mediapipe
FACE_DETECTOR_BACKEND=opencv
# Supported models: VGG-Face, Facenet, Facenet512, OpenFace, DeepFace, DeepID, ArcFace, Dlib, SFace, GhostFaceNet
FACE_MODEL=VGG-Face
# Similarity threshold (0.0 - 1.0). Pairs below this are flagged as mismatch.
FACE_SIMILARITY_THRESHOLD=0.60

# Uploads
UPLOAD_DIR=./tmp_uploads
MAX_FILE_SIZE_MB=10
